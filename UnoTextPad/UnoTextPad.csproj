<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <!--
      net10.0-desktop is the app itself: one build that runs on Windows, macOS and Linux.
      The plain net10.0 target exists only so the unit test project can reference this one.
    -->
    <TargetFrameworks>net10.0-desktop;net10.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>UnoTextPad</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.unotextpad.app</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <!-- The SDK prefixes this with "O=" for the package identity, so it is stored bare here. -->
    <ApplicationPublisher>UnoTextPad</ApplicationPublisher>
    <!-- Package Description -->
    <Description>UnoTextPad powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Mvvm;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

</Project>
