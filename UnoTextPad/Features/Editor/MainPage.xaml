<Page x:Class="UnoTextPad.Features.Editor.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:documents="using:UnoTextPad.Features.Documents"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Grid RowSpacing="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <Border Grid.Row="0"
            Padding="10,7"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

        <Button Content="New"
                Command="{x:Bind ViewModel.NewDocumentCommand}"
                ToolTipService.ToolTip="New tab (Ctrl+N)" />
        <Button Content="Open"
                Command="{x:Bind ViewModel.OpenFilesCommand}"
                ToolTipService.ToolTip="Open files (Ctrl+O)" />
        <Button Content="Save"
                Command="{x:Bind ViewModel.SaveCommand}"
                ToolTipService.ToolTip="Save (Ctrl+S)" />
        <Button Content="Save As"
                Command="{x:Bind ViewModel.SaveAsCommand}"
                ToolTipService.ToolTip="Save as (Ctrl+Shift+S)" />

        <Border Width="1"
                Margin="6,2"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <TextBlock Text="Font" VerticalAlignment="Center" Opacity="0.7" />
        <ComboBox Width="210"
                  MaxDropDownHeight="420"
                  ItemsSource="{x:Bind ViewModel.Settings.AvailableFontFamilies}"
                  SelectedItem="{x:Bind ViewModel.Settings.SelectedFontFamilyName, Mode=TwoWay}"
                  ToolTipService.ToolTip="Editor font family" />

        <!--
          A read-only ComboBox rather than a NumberBox: Uno's NumberBox style still carries a
          UWP-era "RequestedTheme=Light" setter on its focused state, which leaves black text
          on the dark focused background. A list of sizes also matches what editors offer.
        -->
        <ComboBox Width="86"
                  ItemsSource="{x:Bind ViewModel.Settings.AvailableFontSizes}"
                  SelectedItem="{x:Bind ViewModel.Settings.FontSize, Mode=TwoWay}"
                  ToolTipService.ToolTip="Editor font size" />

        <Border Width="1"
                Margin="6,2"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <ToggleButton Content="Word wrap"
                      IsChecked="{x:Bind ViewModel.Settings.IsWordWrapEnabled, Mode=TwoWay}" />
        <ToggleButton Content="{x:Bind ViewModel.Settings.ThemeName, Mode=OneWay}"
                      MinWidth="104"
                      IsChecked="{x:Bind ViewModel.Settings.IsDarkTheme, Mode=TwoWay}"
                      ToolTipService.ToolTip="Switch between light and dark mode" />
      </StackPanel>
    </Border>

    <!--
      Open documents.

      VerticalAlignment must be set explicitly: the default TabView style sets it to Top,
      which would make the control shrink-wrap its content and grow line by line as the user
      types. Stretching it lets the editor fill the window the way Notepad++ does.
    -->
    <TabView Grid.Row="1"
             x:Name="DocumentTabs"
             VerticalAlignment="Stretch"
             TabItemsSource="{x:Bind ViewModel.Documents}"
             SelectedItem="{x:Bind ViewModel.SelectedDocument, Mode=TwoWay}"
             TabWidthMode="SizeToContent"
             CanReorderTabs="True"
             IsAddTabButtonVisible="True"
             AddTabButtonClick="OnAddTabButtonClick"
             TabCloseRequested="OnTabCloseRequested">
      <TabView.TabItemTemplate>
        <DataTemplate x:DataType="documents:DocumentViewModel">
          <TabViewItem Header="{x:Bind DisplayTitle, Mode=OneWay}" IsClosable="True">
            <TabViewItem.Content>
              <TextBox Text="{x:Bind Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       FontFamily="{x:Bind Settings.EditorFontFamily, Mode=OneWay}"
                       FontSize="{x:Bind Settings.FontSize, Mode=OneWay}"
                       TextWrapping="{x:Bind Settings.EditorTextWrapping, Mode=OneWay}"
                       AcceptsReturn="True"
                       IsSpellCheckEnabled="False"
                       TextAlignment="Left"
                       Padding="10,8"
                       BorderThickness="0"
                       CornerRadius="0"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       Loaded="OnEditorLoaded"
                       SelectionChanged="OnEditorSelectionChanged" />
            </TabViewItem.Content>
          </TabViewItem>
        </DataTemplate>
      </TabView.TabItemTemplate>
    </TabView>

    <!-- Status bar -->
    <Border Grid.Row="2"
            Padding="12,5"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnSpacing="20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="{x:Bind ViewModel.StatusFilePath, Mode=OneWay}"
                   TextTrimming="CharacterEllipsis"
                   Opacity="0.75" />
        <TextBlock Grid.Column="1"
                   Text="{x:Bind ViewModel.StatusCaret, Mode=OneWay}"
                   Opacity="0.75" />
        <TextBlock Grid.Column="2"
                   Text="{x:Bind ViewModel.StatusEncoding, Mode=OneWay}"
                   Opacity="0.75" />
        <TextBlock Grid.Column="3"
                   Text="{x:Bind ViewModel.StatusLineEnding, Mode=OneWay}"
                   Opacity="0.75" />
      </Grid>
    </Border>
  </Grid>
</Page>
